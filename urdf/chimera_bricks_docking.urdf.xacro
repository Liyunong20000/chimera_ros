<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragon" >

  <!-- 1: pick_mode 2:docking_mode 3:detaching_mode -->

  <!--<xacro:arg name="fixed_grapple" default="true" />-->

  <!-- spot -->
  <xacro:include filename="$(find chimera_ros)/urdf/spot_dock.urdf.xacro" />

  <!-- free arm -->  
  <xacro:include filename="$(find dragon)/robots/quad/euclid_201709.urdf.xacro" />


  <!-- the following joint should be configurable-->
  <joint name="grapple_attachment_joint" type="fixed">
    <!-- <origin xyz="0.0 0.0 0.224" rpy="${pi} ${pi/2} 0" /> -->
    <origin xyz="0.0 0.0 0.0" rpy="0 ${-pi/2} 0" />
    <axis xyz="1 0 0" />
    <parent link="base_fixture" />
    <child link="root" />
  </joint>
  
  <joint name="wall_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wall_link"/>
    <origin xyz="1.5 0 -0.5" rpy="${0} 0 ${-pi/2}"/>
  </joint>

  <link name="wall_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	<mesh filename="package://chimera_ros/meshes/brick_wall_low.dae" scale="1 1 1" />
      </geometry>
    </visual>
  </link>


  <joint name="end_effector_fixed_joint" type="fixed">
    <parent link="link4"/>
    <child link="end_effector_link"/>
    <origin xyz="${link_length} 0 0" rpy="${0} ${pi/2} ${0}"/>
  </joint>

  <link name="end_effector_link">
    <visual>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <geometry>
       <mesh filename="package://chimera_ros/meshes/end_effector_no_bricks.dae" scale="1 1 1" />
     </geometry>
    </visual>
  </link>
  
  <joint name="docking_mechanism_dragon_joint" type="fixed">
    <parent link="link1"/>
    <child link="docking_mechanism_dragon_link"/>
    <origin xyz="${-link_length/2 + 0.15} 0.005 0" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="docking_mechanism_dragon_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
	<mesh filename="package://chimera_ros/meshes/docking_mechanism_dragon_side.dae" scale="0.18 0.18 0.18" />
      </geometry>
    </visual>
  </link>

</robot>
